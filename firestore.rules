rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global catch-all default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    // Task Validation
    function isValidTask(data) {
      return data.userId == request.auth.uid &&
             data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.priority in ['High', 'Medium', 'Low'] &&
             data.status in ['pending', 'completed'] &&
             data.source in ['classroom', 'manual'] &&
             data.createdAt is int;
    }

    // Team Validation
    function isValidTeam(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.course is string && data.course.size() > 0 && data.course.size() <= 100 &&
             data.description is string && data.description.size() <= 2000 &&
             data.currentMembers is int && data.currentMembers >= 1 && data.currentMembers <= 100 &&
             data.maxMembers is int && data.maxMembers >= 1 && data.maxMembers <= 100 &&
             data.owner is string && data.owner.size() > 0 && data.owner.size() <= 100 &&
             data.status in ['open', 'full'] &&
             data.createdAt is int;
    }

    // Announcement Validation
    function isValidAnnouncement(data) {
      return data.title is string && data.title.size() > 0 && data.title.size() <= 200 &&
             data.description is string && data.description.size() <= 5000 &&
             data.category is string && data.category.size() > 0 && data.category.size() <= 100 &&
             data.isImportant is bool &&
             data.createdAt is int;
    }

    // Collection match blocks
    match /tasks/{taskId} {
      allow read, list: if isSignedIn() && resource.data.userId == request.auth.uid;
      allow create: if isSignedIn() && isValidId(taskId) && isValidTask(incoming());
      allow update: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid && incoming().userId == request.auth.uid && isValidTask(incoming());
      allow delete: if isSignedIn() && isValidId(taskId) && existing().userId == request.auth.uid;
    }

    match /teams/{teamId} {
      allow read, list: if isSignedIn();
      allow create: if isSignedIn() && isValidId(teamId) && isValidTeam(incoming());
      allow update: if isSignedIn() && isValidId(teamId) && isValidTeam(incoming());
      allow delete: if isSignedIn() && isValidId(teamId);
    }

    match /announcements/{announcementId} {
      allow read, list: if isSignedIn();
      allow create, update, delete: if isSignedIn() && isValidId(announcementId) && isValidAnnouncement(incoming());
    }
  }
}
